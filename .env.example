# Docker Image Configuration
IMAGE_NAME=mlcivilengineer/anki-desktop-docker
IMAGE_TAG=main

# User IDs for file permissions
PUID=1000
PGID=1000

# Coolify Configuration (REQUIRED)
# These values are automatically generated by Coolify
COOLIFY_RESOURCE_UUID=your-unique-resource-uuid
COOLIFY_APPLICATION_ID=1
COOLIFY_CONTAINER_NAME=anki-desktop-your-uuid-timestamp

# Domain Configuration (REQUIRED)
# Replace with your actual domain
SERVICE_FQDN_ANKI=anki.yourdomain.com

# Optional: If you want to expose AnkiConnect API on a separate subdomain
# SERVICE_FQDN_ANKICONNECT=ankiconnect.yourdomain.com

# Coolify Project Metadata (optional - Coolify auto-generates these)
COOLIFY_VERSION=4.0.0-beta.434
COOLIFY_BRANCH=main
COOLIFY_PROJECT_NAME=anki-desktop-docker
COOLIFY_RESOURCE_NAME=anki-desktop-production
COOLIFY_SERVICE_NAME=anki-desktop-service
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_PULL_REQUEST_ID=0
COOLIFY_NETWORK_NAME=coolify

# CJK Font Support (uncomment in docker-compose.yml if needed)
# These are commented by default
# DOCKER_MODS=linuxserver/mods:universal-package-install
# INSTALL_PACKAGES=language-pack-zh-hans|fonts-arphic-ukai|fonts-arphic-uming|fonts-ipafont-mincho|fonts-ipafont-gothic|fonts-unfonts-core
